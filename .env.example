# .env.example — copier en .env et adapter.
#
#   cp .env.example .env
#
# Le fichier .env est ignore par git : ne jamais le versionner.
# Pour generer des secrets :  openssl rand -hex 32

# --- Secrets applicatifs -----------------------------------------------------
FLEET_SECRET_KEY=changez-moi-avec-openssl-rand-hex-32

# --- Wazuh -------------------------------------------------------------------
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=changez-moi
WAZUH_DASHBOARD_USER=admin
WAZUH_DASHBOARD_PASSWORD=changez-moi

# none pour un poste local ; full pour verifier les certificats en production
FILEBEAT_SSL_VERIFICATION_MODE=none

# --- Annuaire (optionnel, profil "freeipa") ----------------------------------
# Sans ce profil, l'application s'authentifie sur sa base locale.
FLEET_FREEIPA_MODE=disabled
FLEET_FREEIPA_HOST=freeipa
FLEET_FREEIPA_PORT=389

IPA_DOMAIN=municipal.local
IPA_REALM=MUNICIPAL.LOCAL
IPA_ADMIN_PASSWORD=changez-moi
IPA_DS_PASSWORD=changez-moi
FREEIPA_IMAGE=freeipa/freeipa-server:4.12

# --- Divers ------------------------------------------------------------------
TZ=UTC
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
